/**
 * Cloudflare Workers Configuration — Terminy Leczenia NFZ MCP Server
 *
 * Architecture: createMcpHandler (canonical, Apr-2025+) wrapping fresh
 * McpServer per request. Dual auth pre-handler (JWT via AuthKit JWKS +
 * API key via D1). Public NFZ ITL API — no per-server secrets needed.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "terminy-leczenia",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],

  "build": {
    "command": "npm install && npm run build:widgets && npx tsc --noEmit"
  },

  "assets": {
    "directory": "./web/dist/widgets",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mcp-oauth",
      "database_id": "eac93639-d58e-4777-82e9-f1e28113d5b2"
    }
  ],

  /**
   * Shared platform KV namespace — used for NFZ response caching.
   * Keys prefixed `nfz:`. TTL: 24h for dictionaries, 1h for queue results.
   */
  "kv_namespaces": [
    {
      "binding": "CACHE_KV",
      "id": "fa6ff790f146478e85ea77ae4a5caa4b",
      "preview_id": "4b37112559f2429191633d98781645ca"
    }
  ],

  "vars": {
    "AUTHKIT_DOMAIN": "exciting-domain-65.authkit.app",
    "OAUTH_BASE_URL": "https://panel.wtyczki.ai"
  },

  "routes": [
    {
      "pattern": "terminy-leczenia.wtyczki.ai",
      "custom_domain": true
    }
  ],

  "workers_dev": false,

  "observability": {
    "enabled": true
  },

  "dev": {
    "port": 8787
  }
}
